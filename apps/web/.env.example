# Copy to .env.local (gitignored).
# Server-side /api/analyze-photo route:
ANTHROPIC_API_KEY=
PHOTO_IMPORT_ENABLED=
# Only this Google account may use photo import (it spends your credits). Required in production.
PHOTO_ALLOWED_EMAIL=

# Supabase (Project settings > API). Leave blank to run signed-out with localStorage only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
